# Supabase project credentials
# Find these in your Supabase dashboard: Project Settings > API
# Copy this file to .env.local and fill in the values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
NEXT_PUBLIC_SITE_URL=https://www.newcreationliving.org

# Staff notification recipients (email + SMS when any form is submitted)
# Comma-separated addresses are supported.
# MX for the domain must point to GoDaddy (not Resend Receiving) for support@ to work.
# nclresidences@gmail.com is always alerted in addition to whatever is listed here.
NOTIFY_EMAIL=support@newcreationliving.org,nclresidences@gmail.com
NOTIFY_PHONE=+14047312371

# Owner push notifications (NCL Mobile inbox)
# Must match the secret used by house_list_owner_push_tokens in Supabase.
NOTIFY_OWNER_PUSH_SECRET=set-a-long-random-strin

# Resend (email) — https://resend.com → API Keys
# Verify newcreationliving.org, then use addresses on that domain.
# Tip: do NOT use the same mailbox for both From and To (staff alerts).
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=New Creation Living <support@newcreationliving.org>
# Optional dedicated From for staff alerts (recommended)
RESEND_STAFF_FROM_EMAIL=New Creation Living Alerts <notifications@newcreationliving.org>

# Gmail backup for applicant accept / deny if Resend fails.
# Use a Google App Password for nclresidences@gmail.com, not the inbox login.
# GMAIL_USER=nclresidences@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Twilio (SMS) — https://console.twilio.com
# Use E.164 format for phone numbers (+1XXXXXXXXXX)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
